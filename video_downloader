    def _retry_failed(self):
        failed = [j for j in self.jobs if j.status == "failed"]
        if not failed:
            self._set_status("Nothing to retry", COLORS["text_secondary"])
            return
        for j in failed:
            if j.row is not None:
                j.row.destroy()
        self.jobs = [j for j in self.jobs if j.status != "failed"]
        self.url_box.delete("1.0", "end")
        self.url_box.insert("1.0", "\n".join(j.url for j in failed) + "\n")
        self._start_download()

    def _clear_finished(self):
        keep = []
        for job in self.jobs:
            if job.status in ("done", "failed") and job.row is not None:
                job.row.destroy()
                job.row = job.label = None
            else:
                keep.append(job)
        self.jobs = keep
        if not self.jobs:
            self.queue_empty_label = ctk.CTkLabel(
                self.queue_frame, text="Nothing queued yet", font=(FONT, 11),
                text_color=COLORS["text_muted"])
            self.queue_empty_label.pack(pady=20)
            self.progress_bar.set(0)
            self.percent_label.configure(text="")
        self._refresh_overall()

    def _refresh_job_row(self, job):
        if not job.label:
            return
        icon = {"queued": "⏸", "working": "⏳", "done": "✅", "failed": "❌"}[job.status]
        color = {"queued": COLORS["text_secondary"], "working": COLORS["text_primary"],
                 "done": COLORS["success"], "failed": COLORS["error"]}[job.status]
        job.label.configure(text=f"{icon} #{job.idx}  {job.display_name}", text_color=color)
        job.bar.set(job.pct)
        job.bar.configure(progress_color=COLORS["success"] if job.status == "done"
                          else COLORS["error"] if job.status == "failed" else COLORS["accent"])
        job.pct_label.configure(text=f"{job.pct*100:.0f}%" if job.status in ("working", "done") else "")
        detail = job.error if job.status == "failed" else job.detail
        if job.engine and job.status == "working":
            detail = f"{job.engine}  ·  {detail}" if detail else job.engine
        job.detail_label.configure(text=detail[:110])

    def _job_update(self, job, *, status=None, engine=None, detail=None, pct=None,
                    title=None, error=None, force=True):
        """Thread-safe update of a job's state + row (rate-limited for progress spam)."""
        if status is not None:
            job.status = status
        if engine is not None:
            job.engine = engine
        if detail is not None:
            job.detail = detail
        if pct is not None:
            job.pct = max(0.0, min(1.0, pct))
        if title is not None:
            job.title = title
        if error is not None:
            job.error = error
        now = time.time()
        if not force and now - job.last_ui < 0.25:
            return
        job.last_ui = now
        self.after(0, lambda: self._refresh_job_row(job))
        self.after(0, self._refresh_overall)

    def _jlog(self, job, msg):
        """Log line tagged with the job number (safe from worker threads)."""
        tag = f"[#{job.idx}] " if len(self.jobs) > 1 else ""
        self._log_safe(f"{tag}{msg}")

    def _refresh_overall(self):
        if not self.jobs:
            return
        total = len(self.jobs)
        done = sum(1 for j in self.jobs if j.status == "done")
        failed = sum(1 for j in self.jobs if j.status == "failed")
        working = [j for j in self.jobs if j.status == "working"]
        overall = sum(1.0 if j.status == "done" else j.pct if j.status == "working" else 0
                      for j in self.jobs) / total
        queued = total - done - failed - len(working)
        self.progress_bar.set(overall)
        self.percent_label.configure(text=f"{done + failed}/{total}")
        self.queue_count_label.configure(
            text=f"{len(working)} running · {queued} waiting · {done} done" + (f" · {failed} failed" if failed else ""))
        if self.is_downloading:
            parts = [f"Downloading {len(working)}"]
            if queued:
                parts.append(f"{queued} waiting")
            if done:
                parts.append(f"{done} done")
            if failed:
                parts.append(f"{failed} failed")
            self._set_status("  ·  ".join(parts), COLORS["engine1"])
            self.detail_label.configure(text="   •   ".join(
                f"#{j.idx} {j.pct*100:.0f}%" for j in working)[:120])

