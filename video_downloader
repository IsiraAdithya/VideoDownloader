#  ENGINE 3: DIRECT HTML SCRAPER
# ══════════════════════════════════════════════════════════════
class DirectScraper:
    """
    Fetches raw page HTML and uses regex to find video URLs.
    Fast but won't work for JS-rendered content.
    """

    HEADERS = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.5",
    }

    VIDEO_PATTERNS = [
        r'(https?://[^\s\'"<>]+\.(?:mp4|webm|m3u8|mpd|flv|mov|m4v)(?:\?[^\s\'"<>]*)?)',
        r'"(?:file|src|source|url|video_url|stream_url|hls|dash|mp4|playback_url|content_url)":\s*"(https?://[^\s"]+)"',
        r'<(?:source|video)[^>]+src=["\']?(https?://[^\s"\'<>]+)["\']?',
        r'<meta[^>]+(?:property|name)=["\']og:video(?::url)?["\'][^>]+content=["\']([^"\']+)["\']',
        r'<meta[^>]+content=["\']([^"\']+)["\'][^>]+(?:property|name)=["\']og:video(?::url)?["\']',
    ]

    @staticmethod
    def find_video_urls(page_url, log_callback=None):
        found = []
        seen = set()

        def log(msg):
            if log_callback:
                log_callback(msg)

        log("   Fetching page HTML...")
        try:
            resp = requests.get(page_url, headers=DirectScraper.HEADERS, timeout=15, allow_redirects=True)
            html = resp.text
            log(f"   Got {len(html):,} chars")

            for pattern in DirectScraper.VIDEO_PATTERNS:
                for match in re.finditer(pattern, html, re.IGNORECASE):
                    url = match.group(1) if match.lastindex else match.group(0)
                    url = url.strip().rstrip("\\")
                    if url not in seen and url.startswith("http"):
                        seen.add(url)
                        found.append({"url": url, "content_type": "scraped", "size": 0})
                        log(f"   🎯 Found: {url[:80]}...")

        except Exception as e:
            log(f"   ❌ Scraping failed: {e}")

        return found


# ══════════════════════════════════════════════════════════════
#  DIRECT FILE DOWNLOADER (for Engine 2 & 3 results)
# ══════════════════════════════════════════════════════════════
class FileDownloader:
    """Downloads a direct video URL to disk with progress."""

    @staticmethod
    def download(video_url, save_dir, log_callback=None, progress_callback=None,
                 referer=None, extra_headers=None):
        def log(msg):
            if log_callback:
                log_callback(msg)

        headers = {
            "User-Agent": BROWSER_UA,
            "Referer": referer or video_url,
        }
        headers.update(extra_headers or {})

        log(f"   ⬇ Downloading stream...")
        resp = requests.get(video_url, headers=headers, stream=True, timeout=30)
        resp.raise_for_status()

        total = int(resp.headers.get("content-length", 0))
        content_type = resp.headers.get("content-type", "")

        parsed = urlparse(video_url)
        path_ext = Path(parsed.path).suffix.lower()
        if path_ext in VIDEO_EXTENSIONS:
            ext = path_ext
        elif "mp4" in content_type:
            ext = ".mp4"
        elif "webm" in content_type:
            ext = ".webm"
        else:
            ext = ".mp4"

        filename = f"video_{int(time.time())}{ext}"
        filepath = os.path.join(save_dir, filename)

        downloaded = 0
        with open(filepath, "wb") as f:
            for chunk in resp.iter_content(chunk_size=1024 * 256):
                if chunk:
                    f.write(chunk)
                    downloaded += len(chunk)
                    if progress_callback and total > 0:
                        progress_callback(downloaded, total)

        size_mb = os.path.getsize(filepath) / 1024 / 1024
        log(f"   ✅ Saved: {filename} ({size_mb:.1f} MB)")
        return filepath

    @staticmethod
    def download_m3u8(m3u8_url, save_dir, log_callback=None, referer=None, extra_headers=None):
        """Use ffmpeg to download HLS/DASH streams."""
        def log(msg):
            if log_callback:
                log_callback(msg)

        if not shutil.which("ffmpeg"):
            raise RuntimeError("ffmpeg required for HLS streams. Please install it.")

        filename = f"video_{int(time.time())}.mp4"
        filepath = os.path.join(save_dir, filename)

        log(f"   ⬇ Downloading HLS stream via ffmpeg...")
        cmd = [
            "ffmpeg", "-y",
            "-user_agent", BROWSER_UA,
            "-headers", "".join(f"{k}: {v}\r\n" for k, v in
                                {"Referer": referer or m3u8_url, **(extra_headers or {})}.items()),
            "-i", m3u8_url,
            "-c", "copy",
            "-bsf:a", "aac_adtstoasc",
            filepath
        ]

        process = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if process.returncode != 0:
            raise RuntimeError(f"ffmpeg error: {process.stderr[-200:]}")

        size_mb = os.path.getsize(filepath) / 1024 / 1024
        log(f"   ✅ Saved: {filename} ({size_mb:.1f} MB)")
        return filepath


def safe_filename(name, fallback):
    name = re.sub(r'[\\/:*?"<>|\r\n]+', " ", name or "").strip(" .")
    name = re.sub(r"\s+", " ", name)
    return name[:120] or fallback


class DownloadJob:
    """One URL in the queue, with its own progress state and UI row."""

    def __init__(self, idx, url):
        self.idx = idx
        self.url = url
        self.title = ""
        self.status = "queued"      # queued | working | done | failed
        self.engine = ""
        self.pct = 0.0
        self.detail = ""
        self.error = ""
        self.last_ui = 0.0
        # widgets, filled in by the app
        self.row = self.label = self.pct_label = self.bar = self.detail_label = None

    @property
    def display_name(self):
        return self.title or self.url[:70]


