    def _paste_url(self):
        try:
            text = self.clipboard_get().strip()
            if not text:
                return
            existing = self.url_box.get("1.0", "end").strip()
            if existing and not existing.endswith("\n"):
                self.url_box.insert("end", "\n")
            self.url_box.insert("end", text + "\n")
            self.url_box.see("end")
        except Exception:
            pass

    def _parse_urls(self):
        """URLs from the box: one per line (whitespace-separated also OK), de-duplicated."""
        raw = self.url_box.get("1.0", "end")
        urls, seen = [], set()
        for token in re.split(r"[\s,]+", raw):
            token = token.strip().strip('"\'<>')
            if not token:
                continue
            if not re.match(r"^https?://", token, re.I):
                if "." not in token:
                    continue
                token = "https://" + token
            if token not in seen:
                seen.add(token)
                urls.append(token)
        return urls

