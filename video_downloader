def classify_stream_url(url, content_type=""):
    """Return (is_ad, is_segment, is_manifest) for an intercepted URL."""
    u = url.lower()
    path = urlparse(u).path
    is_ad = any(pat in u for pat in AD_PATTERNS)
    # Many CDNs serve playlists from tokenised paths with no .m3u8 extension;
    # the Content-Type is the reliable signal there.
    is_manifest = (".m3u8" in path or ".mpd" in path
                   or any(m in (content_type or "").lower() for m in MANIFEST_MIME_TYPES))
    is_segment = (not is_manifest) and (
        any(path.endswith(ext) for ext in (".ts", ".m4s", ".m4f")) or
        any(pat in path for pat in ("/seg", "segment", "chunk", "frag", "init.mp4"))
    )
    return is_ad, is_segment, is_manifest


def probe_stream_duration(url, referer=None, timeout=8):
    """
    Best-effort (duration_seconds, is_master_playlist) of an HLS/DASH manifest.
    Pre-roll ads are 6-30s; real content is minutes. This is the single
    most reliable way to tell them apart.
    """
    is_master = False
    from urllib.parse import urljoin
    headers = {}
    if referer:
        headers["Referer"] = referer

    def fetch(u):
        # Manifests on Cloudflare-protected sites need a browser TLS fingerprint
        try:
            from curl_cffi import requests as cffi_requests
            r = cffi_requests.get(u, headers=headers, impersonate="chrome", timeout=timeout)
        except ImportError:
            r = requests.get(u, headers=dict(headers, **{"User-Agent": BROWSER_UA}), timeout=timeout)
        if r.status_code != 200:
            raise RuntimeError(f"HTTP {r.status_code}")
        return r.text

    try:
        text = fetch(url)
        if ".mpd" in url.lower() or "<MPD" in text[:500]:
            m = re.search(r'mediaPresentationDuration="PT(?:(\d+)H)?(?:(\d+)M)?(?:([\d.]+)S)?"', text)
            if m:
                h, mi, sec = (float(x) if x else 0 for x in m.groups())
                return h * 3600 + mi * 60 + sec, True
            return 0, True
        if "#EXT-X-STREAM-INF" in text:  # master playlist -> follow first variant
            is_master = True
            variant = next((l.strip() for l in text.splitlines()
                            if l.strip() and not l.startswith("#")), None)
            if not variant:
                return 0, is_master
            text = fetch(urljoin(url, variant))
        return sum(float(x) for x in re.findall(r"#EXTINF:([\d.]+)", text)), is_master
    except Exception:
        return 0, is_master


# ══════════════════════════════════════════════════════════════
#  DNS BYPASS: ISPs often "block" adult sites by making their DNS
#  resolver answer NXDOMAIN. The site itself is reachable; only the
#  name lookup is sabotaged. We resolve via DNS-over-HTTPS instead.
# ══════════════════════════════════════════════════════════════
import socket

class DNSBypass:
    DOH_URLS = ["https://1.1.1.1/dns-query", "https://8.8.8.8/resolve"]
    _orig_getaddrinfo = socket.getaddrinfo
    _cache = {}
    _blocked = set()
    doh_ok = False
    installed = False

    @classmethod
    def doh_lookup(cls, host):
        """A records for host via DNS-over-HTTPS (cached). [] if nothing."""
        if host in cls._cache:
            return cls._cache[host]
        ips = []
        for base in cls.DOH_URLS:
            try:
                from curl_cffi import requests as cr
                j = cr.get(base, params={"name": host, "type": "A"},
                           headers={"accept": "application/dns-json"}, timeout=8).json()
            except ImportError:
                import json, urllib.request
                from urllib.parse import urlencode
                req = urllib.request.Request(f"{base}?{urlencode({'name': host, 'type': 'A'})}",
                                             headers={"accept": "application/dns-json"})
                j = json.loads(urllib.request.urlopen(req, timeout=8).read())
            except Exception:
                continue
            ips = [a["data"] for a in j.get("Answer", []) if a.get("type") == 1]
            if ips:
                break
        cls._cache[host] = ips
        return ips

    @classmethod
    def system_resolves(cls, host):
        try:
            cls._orig_getaddrinfo(host, 443)
            return True
        except Exception:
            return False

    @classmethod
    def _patched_getaddrinfo(cls, host, port, family=0, type=0, proto=0, flags=0):
        try:
            return cls._orig_getaddrinfo(host, port, family, type, proto, flags)
        except socket.gaierror:
            ips = cls.doh_lookup(host) if isinstance(host, str) else []
            if not ips:
                raise
            cls._blocked.add(host)
            return [(socket.AF_INET, type or socket.SOCK_STREAM, proto or socket.IPPROTO_TCP, "", (ip, port))
                    for ip in ips]

    @classmethod
    def install(cls):
        """
        Patch Python's resolver (urllib/requests/yt-dlp native downloader) to
        fall back to DoH, and teach curl_cffi sessions (yt-dlp impersonation,
        manifest probes) to switch themselves to DoH the moment a lookup fails.
        Nothing changes for networks whose DNS works normally.
        """
        if cls.installed:
            return
        cls.installed = True
        socket.getaddrinfo = cls._patched_getaddrinfo
        try:
            from curl_cffi import CurlOpt
            import curl_cffi.requests.session as cs
            _request = cs.Session.request

            def request(self, method, url, *a, **k):
                try:
                    return _request(self, method, url, *a, **k)
                except Exception as e:
                    msg = str(e)
                    unresolved = getattr(e, "code", None) == 6 or "Could not resolve host" in msg
                    if not unresolved or self.curl_options.get(CurlOpt.DOH_URL):
                        raise
                    host = urlparse(url).hostname or ""
                    if not cls.doh_lookup(host):
                        raise
                    cls._blocked.add(host)
                    self.curl_options[CurlOpt.DOH_URL] = cls.DOH_URLS[0]   # this session now resolves via DoH
                    return _request(self, method, url, *a, **k)
            cs.Session.request = request
            cls.doh_ok = True
        except Exception:
            cls.doh_ok = False

    @classmethod
    def chromium_rules(cls, page_url, log=None):
        """--host-resolver-rules value mapping every blocked host on the page
        (page host + hosts referenced in its HTML) to its real IP."""
        host = urlparse(page_url).hostname or ""
        hosts = {host} if host else set()
        if host and not cls.system_resolves(host):
            try:
                from curl_cffi import requests as cr
                html = cr.get(page_url, impersonate="chrome", timeout=12).text
                hosts.update(h.lower() for h in re.findall(r"https?://([a-z0-9.-]+\.[a-z]{2,})", html, re.I))
            except Exception:
                pass
        rules = []
        for h in sorted(hosts):
            if cls.system_resolves(h):
                continue
            ips = cls.doh_lookup(h)
            if ips:
                rules.append(f"MAP {h} {ips[0]}")
        if rules and log:
            log(f"   🚧 DNS block bypassed for {len(rules)} host(s) in the browser")
        return ",".join(rules)


DNSBypass.install()


def strip_lang_prefix(url):
    """https://site/es/path -> https://site/path (None if no 2-letter prefix).
    Localised URLs often miss yt-dlp's site-specific extractor patterns."""
    m = re.match(r"^(https?://[^/]+)/([a-z]{2}(?:-[a-z]{2})?)/(.+)$", url, re.I)
    return f"{m.group(1)}/{m.group(3)}" if m else None


