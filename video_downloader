    # ══════════════════════════════════════════════════════
    #  YT-DLP OPTIONS (Engine 1)
    # ══════════════════════════════════════════════════════
    def _get_ydl_opts(self, job=None):
        opts = {
            "outtmpl": os.path.join(self.download_path, "%(title).150B.%(ext)s"),
            "noplaylist": True,
            "quiet": True,
            "no_warnings": True,
            "noprogress": True,                   # the queue rows show progress instead
            "progress_hooks": [lambda d, j=job: self._ydl_progress_hook(d, j)] if job else [],
            "concurrent_fragment_downloads": 8,   # parallel HLS/DASH fragments (more lanes only help when the server, not the line, is the cap)
            "overwrites": False,
            # Let the impersonated client supply User-Agent/Accept so they
            # match the TLS fingerprint (Cloudflare checks both).
            "http_headers": {
                "Accept-Language": "en-US,en;q=0.5",
                "Referer": "https://www.google.com/",
            },
            # Cloudflare anti-bot fingerprints the TLS handshake; the generic
            # extractor only bypasses it when told to impersonate a browser
            # (requires the curl_cffi backend: pip install "yt-dlp[curl-cffi]").
            "extractor_args": {"generic": {"impersonate": ["chrome"]}},
            "retries": 5,
            "fragment_retries": 5,
            "socket_timeout": 30,
            "nocheckcertificate": True,
            "geo_bypass": True,
            "legacy_server_connect": True,
        }

        if self.cookie_browser and self.cookie_browser != "None":
            opts["cookiesfrombrowser"] = (self.cookie_browser.lower(),)

        fmt_map = {
            "mp3":        ("bestaudio/best", None, [{"key": "FFmpegExtractAudio", "preferredcodec": "mp3", "preferredquality": "192"}]),
            "mp4_720":    ("bestvideo[height<=720]+bestaudio/best[height<=720]/best", "mp4", None),
            "mp4_1080":   ("bestvideo[height<=1080]+bestaudio/best[height<=1080]/best", "mp4", None),
            "best_video": ("bestvideo+bestaudio/best", "mp4", None),
        }
        fmt, merge, pp = fmt_map.get(self.current_format, fmt_map["best_video"])
        opts["format"] = fmt
        if merge:
            opts["merge_output_format"] = merge
        if pp:
            opts["postprocessors"] = pp
        return opts

    def _watch_partfiles(self, job, ydl, info, stop_event):
        """
        yt-dlp gets no progress back from aria2c, so poll the growing .part
        file(s) on disk and feed their size to the job row until stop_event.
        """
        import glob
        try:
            base = os.path.splitext(ydl.prepare_filename(info))[0]
        except Exception:
            return
        fmts = info.get("requested_formats") or [info]
        total = sum((f.get("filesize") or f.get("filesize_approx") or 0) for f in fmts)
        if not total:
            # direct links often carry no size in the metadata: ask the server
            for f in fmts:
                try:
                    r = requests.get(f["url"], headers=f.get("http_headers") or {},
                                     stream=True, timeout=10)
                    total += int(r.headers.get("content-length") or 0)
                    r.close()
                except Exception:
                    pass
        last_size, last_t = 0, time.time()
        while not stop_event.wait(0.5):
            try:
                size = 0
                parts = glob.glob(glob.escape(base) + "*.part")
                for part in parts:
                    prog = aria2_control_progress(part)
                    if prog:
                        size += prog[0]
                        if not total:
                            total = prog[1]
                    else:
                        size += os.path.getsize(part)
            except Exception:
                continue
            if size <= 0:
                continue
            now = time.time()
            speed = (size - last_size) / (now - last_t) if now > last_t else 0
            last_size, last_t = size, now
            parts = [f"{self._format_bytes(size)}" + (f" / {self._format_bytes(total)}" if total else "")]
            if speed > 0:
                parts.append(f"⚡ {self._format_bytes(speed)}/s")
            if total and speed > 0:
                parts.append(f"⏱ {timedelta(seconds=int((total - size) / speed))}")
            self._job_update(job, pct=min(size / total, 0.99) if total else job.pct,
                             detail="   •   ".join(parts), force=False)

    def _ydl_progress_hook(self, d, job):
        if job is None:
            return
        if d["status"] == "downloading":
            total = d.get("total_bytes") or d.get("total_bytes_estimate") or 0
            downloaded = d.get("downloaded_bytes", 0)
            speed = d.get("speed")
            eta = d.get("eta")
            pct = downloaded / total if total > 0 else job.pct
            parts = []
            if total > 0:
                parts.append(f"{self._format_bytes(downloaded)} / {self._format_bytes(total)}")
            if speed:
                parts.append(f"⚡ {self._format_bytes(speed)}/s")
            if eta:
                parts.append(f"⏱ {timedelta(seconds=int(eta))}")
            self._job_update(job, pct=pct, detail="   •   ".join(parts), force=False)
        elif d["status"] == "finished":
            self._job_update(job, pct=1.0, detail="merging / finishing...")

    # ══════════════════════════════════════════════════════
    #  MASTER DOWNLOAD ORCHESTRATOR
    # ══════════════════════════════════════════════════════
    def _start_download(self):
        """Add whatever is in the URL box to the queue and start it right away.
        Works at any time, including while other downloads are running."""
        urls = self._parse_urls()
        if not urls:
            self._set_status("⚠  Paste at least one URL first", COLORS["warning"])
            return

        busy = {j.url for j in self.jobs if j.status in ("queued", "working")}
        new_jobs = []
        for u in urls:
            if u in busy:
                continue
            job = DownloadJob(self._next_idx, u)
            self._next_idx += 1
            new_jobs.append(job)
        if not new_jobs:
            self._set_status("⚠  Those URLs are already in the queue", COLORS["warning"])
            return

        self.jobs.extend(new_jobs)
        self._build_job_rows(new_jobs)
        self.url_box.delete("1.0", "end")

        first_batch = not self.is_downloading
        self.is_downloading = True
        if first_batch and all(j.status in ("done", "failed") for j in self.jobs if j not in new_jobs):
            self.detail_label.configure(text="")
        self._log("━" * 52)
        for job in new_jobs:
            self._log(f"➕ #{job.idx} {job.url}")
        self._log(f"📦 {self.current_format}  📁 {self.download_path}  ⚡ up to {self.max_parallel} at once")

        with self._sched_lock:
            self._pending.extend(new_jobs)
        self._schedule()
        self._refresh_overall()

    def _schedule(self):
        """Start pending jobs while there are free slots (honours the live
        'at once' setting). Safe to call from any thread."""
        to_start = []
        with self._sched_lock:
            while self._pending and self._active < self.max_parallel:
                job = self._pending.pop(0)
                self._active += 1
                to_start.append(job)
        for job in to_start:
            threading.Thread(target=self._run_job, args=(job,),
                             name=f"dl-{job.idx}", daemon=True).start()

    def _run_job(self, job):
        self._job_update(job, status="working", detail="starting engines...")
        try:
            ok = self._download_orchestrator(job)
        except Exception as e:
            ok = False
            job.error = " ".join(str(e).split())[:150]
        if ok:
            self._job_update(job, status="done", pct=1.0, detail="saved to " + self.download_path)
        else:
            self._job_update(job, status="failed", error=job.error or "all engines failed")

        with self._sched_lock:
            self._active -= 1
            idle = self._active == 0 and not self._pending
        self._schedule()
        if idle:
            self.after(0, self._queue_finished)

    def _download_orchestrator(self, job):
        """
        Tries engines in order for ONE job; returns True on success.
          1. yt-dlp (fastest, best for supported sites)
          2. Playwright browser (intercepts real video network traffic)
          3. Direct HTML scraping (fast regex fallback)
        """
        url = job.url
        log = lambda m: self._jlog(job, m)

        host = urlparse(url).hostname or ""
        if host and not DNSBypass.system_resolves(host):
            ips = DNSBypass.doh_lookup(host)
            if ips:
                log(f"🚧 Your ISP's DNS blocks {host} → resolving via DNS-over-HTTPS ({ips[0]})")
            else:
                log(f"🚧 {host} does not resolve, even via DNS-over-HTTPS; the site may be down")

        # ── ENGINE 1: yt-dlp ──────────────────────────────
        log("")
        log("⚡ ━━━ ENGINE 1: yt-dlp ━━━━━━━━━━━━━━━━━━━━━━━")
        self._job_update(job, engine="Engine 1: yt-dlp", detail="extracting...")

        # 1st try: fastest path (aria2c multi-connection for plain files).
        # 2nd try: native downloader with the browser TLS fingerprint on EVERY
        # request - needed when a CDN 403s anything that isn't a real browser.
        fast = aria2c_opts()
        if fast and host and not DNSBypass.system_resolves(host):
            # aria2c uses Windows DNS, which is what's blocked: give it its own resolvers
            fast = dict(fast, external_downloader_args={
                "aria2c": fast["external_downloader_args"]["aria2c"]
                + ["--async-dns=true", "--async-dns-server=1.1.1.1,8.8.8.8"]})
        attempts = [(" (aria2c x16)" if fast else "", fast)]
        if impersonate_target():
            attempts.append((" (full browser impersonation)", {"impersonate": impersonate_target()}))
        for label, extra in attempts:
            try:
                opts = dict(self._get_ydl_opts(job), **extra)
                with yt_dlp.YoutubeDL(opts) as ydl:
                    dl_url = url
                    info = ydl.extract_info(url, download=False)
                    generic = {"generic", "html5", "html5mediaembed"}
                    alt = strip_lang_prefix(url)
                    if alt and str(info.get("extractor_key") or info.get("extractor") or "").lower() in generic:
                        try:
                            alt_info = ydl.extract_info(alt, download=False)
                            if str(alt_info.get("extractor_key") or "").lower() not in generic:
                                log(f"   ↪ {alt_info.get('extractor')} extractor matched the non-localised URL")
                                info, dl_url = alt_info, alt
                        except Exception:
                            pass
                    title = info.get("title", "Unknown")
                    log(f"   ✓ Found: {title}{label}")
                    self._job_update(job, title=title, detail="downloading...")
                    stop = threading.Event()
                    watcher = None
                    if "external_downloader" in opts:
                        watcher = threading.Thread(target=self._watch_partfiles,
                                                   args=(job, ydl, info, stop), daemon=True)
                        watcher.start()
                    try:
                        ydl.download([dl_url])
                    finally:
                        stop.set()
                        if watcher:
                            watcher.join(timeout=2)
                return True
            except Exception as e:
                job.error = " ".join(str(e).split())[:150]
                log(f"   ✗ {job.error}")
                err = job.error.lower()
                if not any(k in err for k in ("403", "forbidden", "aria2c", "unable to download")):
                    break   # not an access/downloader problem; retrying won't help

        # ── ENGINE 2: Playwright ──────────────────────────
        if self.playwright_available:
            log("")
            log("🌐 ━━━ ENGINE 2: Browser Intercept ━━━━━━━━━━━━")
            self._job_update(job, engine="Engine 2: Browser", pct=0, detail="scanning page...")

            try:
                videos = BrowserInterceptor.find_video_urls(url, log_callback=log, timeout=45)

                if videos:
                    n_ads = sum(1 for v in videos if v.get("is_ad"))
                    n_seg = sum(1 for v in videos if v.get("is_segment"))
                    log(f"   ✓ {len(videos)} stream(s) captured "
                        f"({n_ads} ad, {n_seg} chunks, {len(videos)-n_ads-n_seg} content)")
                    best = self._pick_best_video(videos, log)
                    log(f"   ▶ Best: {best['url'][:80]}...")
                    if best.get("page_title"):
                        self._job_update(job, title=best["page_title"])
                    self._job_update(job, detail="downloading stream...")

                    self._download_candidate(best, url, job)
                    return True
                else:
                    log("   ✗ No video streams detected in browser")
                    job.error = "no video streams detected in browser"
            except Exception as e:
                job.error = " ".join(str(e).split())[:150]
                log(f"   ✗ {job.error}")
        else:
            log("")
            log("🌐 ━━━ ENGINE 2: SKIPPED (not installed) ━━━━━━")
            log("   💡 Click 'Install Browser' for full support")

        # ── ENGINE 3: Direct Scraping ─────────────────────
        log("")
        log("📄 ━━━ ENGINE 3: Direct Scraper ━━━━━━━━━━━━━━━")
        self._job_update(job, engine="Engine 3: Scraper", pct=0, detail="scanning source...")

        try:
            videos = DirectScraper.find_video_urls(url, log_callback=log)

            if videos:
                log(f"   ✓ {len(videos)} URL(s) found in source")
                best = self._pick_best_video(videos, log)
                log(f"   ▶ Trying: {best['url'][:80]}...")
                self._job_update(job, detail="downloading...")

                self._download_candidate(best, url, job)
                return True
            else:
                log("   ✗ No video URLs in page source")
                job.error = job.error or "no video URLs in page source"
        except Exception as e:
            job.error = " ".join(str(e).split())[:150]
            log(f"   ✗ {job.error}")

        return False

    def _pick_best_video(self, videos, log=None):
        """
        Select the most likely *content* stream from the candidates.
        Ads lose on every axis: known ad hosts, ad-length duration, small
        size, and arriving first (pre-roll) before the real manifest.
        """
        def score(v):
            url = v["url"].lower()
            is_ad, is_segment, is_manifest = classify_stream_url(url)
            is_ad = v.get("is_ad", is_ad)
            is_segment = v.get("is_segment", is_segment)
            s = 0.0
            if is_ad:
                s -= 1000
            if is_segment:
                s -= 500          # a lone chunk is never what the user wants
            dur = v.get("duration", 0) or 0
            if dur:
                s += min(dur, 7200) / 10        # 10 min -> +60, 1 h -> +360
                if dur < 45:
                    s -= 150                    # pre-roll length
            if is_manifest:
                s += 40                         # real players use HLS/DASH
            if v.get("is_master"):
                s += 10                         # master playlist: lets yt-dlp choose quality
            size = v.get("size", 0) or 0
            if size:
                s += min(size / 1_000_000, 500) / 5   # 100 MB -> +20
                if size < 1_500_000 and not is_manifest:
                    s -= 60                         # sub-1.5MB file: hover preview / bumper
            if any(pat in url for pat in PREVIEW_PATTERNS):
                s -= 80
            if v.get("content_type") == "dom-extracted":
                s += 15
            if ".mp4" in url or ".webm" in url:
                s += 5
            return s

        log = log or self._log_safe
        ranked = sorted(videos, key=score, reverse=True)
        best = ranked[0]
        if len(ranked) > 1:
            log(f"   🏆 Picked {urlparse(best['url']).netloc} "
                f"(score {score(best):.0f}, {len(ranked)-1} other candidate(s))")
        if best.get("is_ad"):
            log("   ⚠ Only ad streams were captured; the real player may need login/cookies")
        return best

    def _download_candidate(self, best, page_url, job):
        """
        Download an intercepted stream URL. yt-dlp first (handles master
        playlists, best-quality selection and A/V merging, with the page as
        Referer); fall back to the raw downloaders if it refuses.
        """
        video_url = best["url"]
        log = lambda m: self._jlog(job, m)
        base = safe_filename(best.get("page_title") or job.title,
                             f"video_{int(time.time())}_{job.idx}")

        # Replay what the real browser sent: same Referer/Origin, same UA the
        # cookies were issued to, and the session cookies themselves.
        req = {k.lower(): v for k, v in (best.get("req_headers") or {}).items()}
        headers = {"User-Agent": BROWSER_UA, "Referer": req.get("referer") or page_url}
        if req.get("origin"):
            headers["Origin"] = req["origin"]
        cookies = best.get("cookies") or []
        cookie_file = None
        if cookies:
            try:
                import tempfile
                cookie_file = write_cookie_jar(
                    cookies, os.path.join(tempfile.gettempdir(), f"stellar_cookies_{job.idx}_{int(time.time())}.txt"))
            except Exception:
                cookie_file = None

        try:
            opts = self._get_ydl_opts(job)
            opts["http_headers"] = dict(opts.get("http_headers", {}), **headers)
            opts["outtmpl"] = os.path.join(self.download_path, base + ".%(ext)s")
            if cookie_file:
                opts["cookiefile"] = cookie_file
                opts.pop("cookiesfrombrowser", None)
            if impersonate_target():
                opts["impersonate"] = impersonate_target()
            with yt_dlp.YoutubeDL(opts) as ydl:
                ydl.download([video_url])
            return
        except Exception as e:
            log(f"   ↪ yt-dlp couldn't take the stream ({' '.join(str(e).split())[:90]}), using raw downloader")
        finally:
            if cookie_file:
                try:
                    os.remove(cookie_file)
                except Exception:
                    pass

        extra = dict(headers)
        cookie_hdr = cookies_for_url(cookies, video_url)
        if cookie_hdr:
            extra["Cookie"] = cookie_hdr
        if ".m3u8" in video_url.lower() or ".mpd" in video_url.lower() or best.get("is_manifest"):
            FileDownloader.download_m3u8(video_url, self.download_path,
                                         log_callback=log, referer=headers["Referer"], extra_headers=extra)
        else:
            FileDownloader.download(video_url, self.download_path,
                                    log_callback=log,
                                    progress_callback=self._direct_progress(job),
                                    referer=headers["Referer"], extra_headers=extra)

    def _direct_progress(self, job):
        def cb(downloaded, total):
            if total > 0:
                self._job_update(job, pct=downloaded / total,
                                 detail=f"{self._format_bytes(downloaded)} / {self._format_bytes(total)}",
                                 force=False)
        return cb

    # ══════════════════════════════════════════════════════
    #  COMPLETION
    # ══════════════════════════════════════════════════════
    def _queue_finished(self):
        with self._sched_lock:
            if self._active or self._pending:
                return          # something was added in the meantime
        self.is_downloading = False
        total = len(self.jobs)
        done = sum(1 for j in self.jobs if j.status == "done")
        failed = sum(1 for j in self.jobs if j.status == "failed")
        self.progress_bar.set(1.0 if failed == 0 else done / max(total, 1))
        self.percent_label.configure(text=f"{done}/{total}")
        self.detail_label.configure(text="")
        self._log("━" * 52)
        if failed == 0:
            self._set_status(f"All {total} download(s) complete!", COLORS["success"])
            self._log(f"✅ All {total} download(s) complete!")
        else:
            self._set_status(f"{done} done, {failed} failed", COLORS["error"] if done == 0 else COLORS["warning"])
            self._log(f"⚠ {done} succeeded, {failed} failed:")
            for j in self.jobs:
                if j.status == "failed":
                    self._log(f"   ❌ #{j.idx} {j.url[:70]}  —  {j.error}")
            self._log("")
            self._log("💡 For the failed ones try:")
            self._log("  1. 🔄 Update yt-dlp")
            self._log("  2. 🌐 Install Browser Engine (Engine 2)")
            self._log("  3. 🍪 Set cookies to Chrome/Firefox")
            self._log("  4. Check if the video plays in your browser")
        self._log(f"📁 {self.download_path}")
        self._reset_btn()

    def _reset_btn(self):
        self.download_btn.configure(
            text="⬇  ADD & DOWNLOAD", fg_color=COLORS["accent"], state="normal"
        )


