class BrowserInterceptor:
    """
    Opens a real headless Chromium browser, navigates to the URL,
    and intercepts ALL network responses to find video streams.
    Works like DevTools Network tab — catches everything.
    """

    @staticmethod
    def is_available():
        try:
            from playwright.sync_api import sync_playwright
            return True
        except ImportError:
            return False

    @staticmethod
    def install():
        subprocess.check_call([sys.executable, "-m", "pip", "install", "playwright"])
        subprocess.check_call([sys.executable, "-m", "playwright", "install", "chromium"])

    @staticmethod
    def find_video_urls(page_url, log_callback=None, timeout=30):
        """
        Navigate to page_url in a real browser and intercept all
        network traffic to find video stream URLs.
        Returns list of dicts: [{url, content_type, size}, ...]
        """
        from playwright.sync_api import sync_playwright

        found_videos = []
        seen_urls = set()

        def log(msg):
            if log_callback:
                log_callback(msg)

        log("   Launching headless Chromium...")
        launch_args = [
            "--disable-blink-features=AutomationControlled",
            "--no-sandbox",
            "--disable-web-security",
        ]
        rules = DNSBypass.chromium_rules(page_url, log)
        if rules:
            launch_args.append(f"--host-resolver-rules={rules}")

        with sync_playwright() as p:
            browser = p.chromium.launch(headless=True, args=launch_args)
            context = browser.new_context(
                user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
                viewport={"width": 1920, "height": 1080},
                java_script_enabled=True,
                bypass_csp=True,
            )
            page = context.new_page()

            def on_response(response):
                try:
                    url = response.url
                    if url in seen_urls:
                        return
                    seen_urls.add(url)

                    content_type = response.headers.get("content-type", "")
                    content_length = int(response.headers.get("content-length", 0))

                    parsed = urlparse(url)
                    path_lower = parsed.path.lower()
                    has_video_ext = any(path_lower.endswith(ext) for ext in VIDEO_EXTENSIONS)
                    has_video_mime = any(mime in content_type.lower() for mime in VIDEO_MIME_TYPES)
                    is_video_cdn = any(pat in url.lower() for pat in [
                        "/video", "/media", "/stream", "/hls/", "/dash/",
                        ".m3u8", ".mpd", "/manifest", "/playlist",
                        "googlevideo.com", "videoplayback", "cdn",
                    ])

                    if has_video_ext or has_video_mime or (is_video_cdn and content_length > MIN_VIDEO_SIZE):
                        is_ad, is_segment, is_manifest = classify_stream_url(url, content_type)
                        # Ad SDKs load lots of tiny ad assets; don't pollute the candidate list
                        if is_ad and not (is_manifest or has_video_ext or has_video_mime):
                            return
                        entry = {
                            "url": url,
                            "content_type": content_type,
                            "size": content_length,
                            "is_ad": is_ad,
                            "is_segment": is_segment,
                            "is_manifest": is_manifest,
                            "t": time.time() - t_start,
                        }
                        try:
                            # exact headers the real player sent (Referer/Origin/tokens)
                            entry["req_headers"] = response.request.all_headers()
                        except Exception:
                            entry["req_headers"] = {}
                        found_videos.append(entry)
                        if is_segment:
                            return  # keep quiet about individual chunks
                        size_str = f"{content_length / 1024 / 1024:.1f} MB" if content_length else "? size"
                        tag = "🚫 Ad stream" if is_ad else ("🎯 Manifest" if is_manifest else "🎯 Found")
                        log(f"   {tag}: {content_type or 'video'} ({size_str}) {urlparse(url).netloc}")

                except Exception:
                    pass

            t_start = time.time()
            page.on("response", on_response)

            log(f"   Navigating to page...")
            try:
                page.goto(page_url, wait_until="domcontentloaded", timeout=min(timeout, 25) * 1000)
            except Exception as e:
                log(f"   ⚠ Nav warning: {str(e)[:80]}")
            log(f"   (page loaded in {time.time() - t_start:.0f}s)")
            try:
                page_title = page.title()
            except Exception:
                page_title = ""

            # Wait for video player to initialize
            log("   Waiting for video player...")
            page.wait_for_timeout(3000)

            # Try clicking play buttons
            play_selectors = [
                "button[class*='play']", "[class*='play-btn']",
                "[class*='player'] button", "video", ".vjs-big-play-button",
                "[aria-label*='play' i]", "[title*='play' i]",
                ".play-button", "#play-button", ".btn-play",
            ]
            for selector in play_selectors:
                try:
                    el = page.query_selector(selector)
                    if el and el.is_visible():
                        # Short timeout: ad overlays often cover the button and
                        # Playwright would otherwise wait 30s per selector.
                        el.click(timeout=1500)
                        log("   ▶ Clicked play button")
                        break
                except Exception:
                    continue

            # Keep listening through the pre-roll. Ads play first and the real
            # player often only requests its manifest once the ad finishes, so
            # we poll until a non-ad stream shows up (or we run out of time).
            def good_candidates():
                return [v for v in found_videos if not v["is_ad"] and not v["is_segment"]]

            def dom_video_state():
                try:
                    return page.evaluate("""
                        () => Array.from(document.querySelectorAll('video')).map(v => ({
                            src: v.currentSrc || v.src || '',
                            duration: (isFinite(v.duration) ? v.duration : 0),
                            paused: v.paused,
                        }))
                    """) or []
                except Exception:
                    return []

            log("   ⏳ Listening for the real stream (skipping ads)...")
            deadline = time.time() + max(timeout - 5, 15)
            content_seen_at = None
            while time.time() < deadline:
                page.wait_for_timeout(1500)
                vids = dom_video_state()
                long_vid = max((v["duration"] for v in vids), default=0)
                good = good_candidates()
                if good and content_seen_at is None:
                    content_seen_at = time.time()
                    log(f"   ✓ Non-ad stream detected after {good[0]['t']:.0f}s")
                # A <video> element reporting minutes of content = main video is up
                if good and long_vid >= 60:
                    log(f"   ✓ Player reports {long_vid/60:.1f} min of content")
                    break
                # Give the player a few seconds after the first good stream to
                # also fetch the master playlist / higher qualities, then stop
                if content_seen_at and time.time() - content_seen_at > 6:
                    break

            # Remember durations the DOM told us about (direct src players)
            for v in dom_video_state():
                src = v.get("src") or ""
                for entry in found_videos:
                    if src and src == entry["url"] and v.get("duration"):
                        entry["duration"] = v["duration"]

            # Extract video src from DOM
            try:
                video_srcs = page.evaluate("""
                    () => {
                        const urls = new Set();
                        document.querySelectorAll('video, video source, source').forEach(el => {
                            if (el.src) urls.add(el.src);
                            if (el.currentSrc) urls.add(el.currentSrc);
                        });
                        document.querySelectorAll('iframe').forEach(el => {
                            if (el.src) urls.add(el.src);
                        });
                        document.querySelectorAll('meta[property="og:video"], meta[property="og:video:url"]').forEach(el => {
                            if (el.content) urls.add(el.content);
                        });
                        document.querySelectorAll('script[type="application/ld+json"]').forEach(el => {
                            try {
                                const data = JSON.parse(el.textContent);
                                if (data.contentUrl) urls.add(data.contentUrl);
                                if (data.embedUrl) urls.add(data.embedUrl);
                            } catch {}
                        });
                        return [...urls].filter(u => u && u.startsWith('http'));
                    }
                """)
                for src in video_srcs:
                    if src not in seen_urls:
                        is_ad, is_segment, is_manifest = classify_stream_url(src)
                        src_path = urlparse(src.lower()).path
                        looks_like_media = is_manifest or any(src_path.endswith(e) for e in VIDEO_EXTENSIONS)
                        if not looks_like_media:
                            continue   # iframe / embed page URLs are not downloadable streams
                        found_videos.append({"url": src, "content_type": "dom-extracted", "size": 0,
                                             "is_ad": is_ad, "is_segment": is_segment,
                                             "is_manifest": is_manifest, "t": time.time() - t_start})
                        log(f"   🎯 DOM source: {src[:80]}...")
                        seen_urls.add(src)
            except Exception:
                pass

            # Extra wait if nothing found
            if not found_videos:
                log("   ⏳ Extended wait for lazy-loaded content...")
                page.wait_for_timeout(8000)

            log(f"   (capture finished in {time.time() - t_start:.0f}s, closing browser)")
            try:
                session_cookies = context.cookies()
            except Exception:
                session_cookies = []
            try:
                context.close()
                browser.close()
            except Exception:
                pass

        # Probe how long each non-ad manifest actually is. A 15s playlist is
        # an ad even if it came from an unknown host; a 20-minute one is the show.
        probed = 0
        for v in found_videos:
            if v["is_manifest"] and not v["is_ad"] and not v.get("duration") and probed < 6:
                probed += 1
                d, v["is_master"] = probe_stream_duration(v["url"], referer=page_url)
                if d:
                    v["duration"] = d
                    flag = "" if d >= 45 else "  (ad-length, skipping)"
                    log(f"   ⏱ {d/60:.1f} min  ←  {urlparse(v['url']).netloc}{flag}")

        for v in found_videos:
            v["page_title"] = page_title
            v["cookies"] = session_cookies
        if session_cookies:
            log(f"   🍪 {len(session_cookies)} session cookie(s) captured for the download")
        return found_videos


