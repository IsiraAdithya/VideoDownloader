def cookies_for_url(cookies, url):
    """Browser cookies (Playwright dicts) that apply to this URL -> 'a=b; c=d'."""
    host = urlparse(url).hostname or ""
    out = []
    for c in cookies or []:
        dom = (c.get("domain") or "").lstrip(".").lower()
        if dom and (host == dom or host.endswith("." + dom)):
            out.append(f"{c['name']}={c['value']}")
    return "; ".join(out)


def write_cookie_jar(cookies, path):
    """Dump Playwright cookies as a Netscape cookie file for yt-dlp."""
    lines = ["# Netscape HTTP Cookie File", ""]
    for c in cookies or []:
        dom = c.get("domain") or ""
        exp = c.get("expires") or 0
        exp = int(exp) if exp and exp > 0 else 0
        lines.append("\t".join([
            dom, "TRUE" if dom.startswith(".") else "FALSE", c.get("path") or "/",
            "TRUE" if c.get("secure") else "FALSE", str(exp), c["name"], c["value"],
        ]))
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    return path


def aria2c_opts():
    """yt-dlp options that hand plain-file downloads to aria2c with 16
    connections. Many CDNs cap a single connection far below the line speed;
    splitting the file lifts that without touching quality. Empty if aria2c
    is not installed (winget install aria2.aria2)."""
    if not shutil.which("aria2c"):
        return {}
    return {
        "external_downloader": {"default": "aria2c"},
        "external_downloader_args": {
            "aria2c": ["-k1M", "--max-connection-per-server=16", "--quiet=true"],
        },
    }


def aria2_control_progress(part_path):
    """
    (downloaded_bytes, total_bytes) from aria2's <file>.aria2 control file.
    aria2 writes pieces out of order, so the .part file's size is meaningless
    for progress; the control file's bitfield of finished pieces is exact.
    Returns None if the control file is missing or unreadable.
    """
    import struct
    try:
        with open(part_path + ".aria2", "rb") as f:
            data = f.read()
        pos = 0
        _ver, _ext = struct.unpack_from(">HI", data, pos); pos += 6
        (ih_len,) = struct.unpack_from(">I", data, pos); pos += 4 + ih_len
        (piece_len,) = struct.unpack_from(">I", data, pos); pos += 4
        total, _upload = struct.unpack_from(">QQ", data, pos); pos += 16
        (bf_len,) = struct.unpack_from(">I", data, pos); pos += 4
        bitfield = data[pos:pos + bf_len]; pos += bf_len
        done_pieces = sum(bin(b).count("1") for b in bitfield)
        n_pieces = (total + piece_len - 1) // piece_len if piece_len else 0
        done = done_pieces * piece_len
        if n_pieces and bitfield and (bitfield[(n_pieces - 1) // 8] >> (7 - (n_pieces - 1) % 8)) & 1:
            done -= piece_len - (total - (n_pieces - 1) * piece_len)   # last piece is shorter
        # partially downloaded (in-flight) pieces
        (n_inflight,) = struct.unpack_from(">I", data, pos); pos += 4
        for _ in range(n_inflight):
            _idx, plen, pbf_len = struct.unpack_from(">III", data, pos)
            pos += 12
            pbf = data[pos:pos + pbf_len]; pos += pbf_len
            # sub-piece bitfield: each bit = 16 KiB block
            done += min(sum(bin(b).count("1") for b in pbf) * 16384, plen)
        return min(done, total), total
    except Exception:
        return None


